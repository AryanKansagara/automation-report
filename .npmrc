# onnxruntime-node (a dependency of @huggingface/transformers) downloads CUDA binaries from
# GitHub in its postinstall on Linux x64, which fails on machines without them (`npm ci` exits 1).
# This app only runs the model in the browser, so the CUDA provider is never needed.
# onnxruntime-node reads this as npm_config_onnxruntime_node_install_cuda.
onnxruntime-node-install-cuda=skip
